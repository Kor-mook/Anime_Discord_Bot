# Discord Developer Portal에서 생성합니다. 절대 Git에 커밋하지 마세요.
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# 개발 서버 전용 명령 등록 시 설정합니다. 비워두면 전역 명령으로 등록됩니다.
DISCORD_GUILD_ID=
# Required to unlock local log-console commands. Do not commit a real value.
BOT_CONSOLE_PASSWORD=
# Shared Neon PostgreSQL URL. Discord user IDs are the web-account keys.
BOT_DATABASE_URL=

# 개발자 A가 제공할 Conversation API와 음성 서비스 주소입니다.
BOT_API_BASE_URL=https://anime-discord-bot-rw3b.vercel.app
BOT_SECRET_KEY=
VOICE_SERVICE_BASE_URL=http://localhost:8000

# API가 아직 없을 때 텍스트 명령을 로컬에서 점검하는 용도입니다.
# 실제 서버에서는 반드시 false로 둡니다.
# Production/default: all turns go to A. local-direct is forbidden with NODE_ENV=production.
BOT_RUNTIME_MODE=service

BOT_DEV_ECHO_MODE=false
# 이 채널에서는 봇 멘션 없이도 일반 메시지에 답합니다.
BOT_AUTO_REPLY_CHANNEL_ID=

# Legacy direct flag. It has no effect unless BOT_RUNTIME_MODE=local-direct is
# also set in a non-production local environment.
BOT_TEST_DIRECT_GEMINI=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Comma-separated allowlist for the Discord /model command. Include GEMINI_MODEL.
GEMINI_AVAILABLE_MODELS=gemini-3.5-flash-lite,gemini-3.6-flash
GEMINI_MAX_OUTPUT_TOKENS=1024
# The bot derives its public links from BOT_API_BASE_URL:
# /billing (plans and upgrades), /settings/privacy (voice-processing consent).
# Local HTTP listener for authenticated website consent-change events.
BOT_VOICE_CONSENT_INVALIDATION_PORT=3002
# LOCAL DEVELOPMENT ONLY. Requires BOT_RUNTIME_MODE=local-direct as a second opt-in.
BOT_TEST_DIRECT_LLM=false
LLM_PROVIDER=grok
LLM_MODEL=grok-4.5
# Comma-separated allowlist for /loveai model. Include LLM_MODEL.
LLM_AVAILABLE_MODELS=grok-4.5
LLM_MAX_OUTPUT_TOKENS=1024
